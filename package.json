{
  "name": "fleetos",
  "version": "1.0.0",
  "description": "Sistema de gestão de frota",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"node --max-old-space-size=4096 node_modules/vite/bin/vite.js\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "mysql2": "^3.9.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.fleetos.app",
    "productName": "FleetOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*"
    ]
  }
}
